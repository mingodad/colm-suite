# Dangling else with `then` and `else` at different levels: resolved by level.
lex
	literal `if `then `else `x
	ignore / [ \t\n\r]+ /
end

precedence `then
precedence `else

def start
	[ stmt ]

def stmt
	[ `if stmt `then stmt ]
  | [ `if stmt `then stmt `else stmt ]
  | [ `x ]

parse C: start[stdin]
